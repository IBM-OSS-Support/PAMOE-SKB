# BAMOE Deployment Configuration
# Note: Deployment ID is now selected dynamically in the UI
# No need to set DEPLOYMENT_ID here

# Kubernetes Configuration
# Namespace where BAMOE deployments are located
K8S_NAMESPACE=local-kie-sandbox-dev-deployments

# BAMOE MCP Server Configuration
# Note: OpenAPI URL is now generated dynamically based on selected deployment
# No need to set BAMOE_OPENAPI_URL here

# Ollama Configuration (for LLM)
# Ollama runs in a container with the granite4:small-h model pre-loaded
# No manual installation required!
OLLAMA_MODEL=granite4:small-h
OLLAMA_HOST=http://ollama:11434

# Application Port
PORT=3000